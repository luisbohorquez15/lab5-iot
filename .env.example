# Copia este archivo como .env y cambia los valores.  NO subas .env al repo.
#   cp .env.example .env

INFLUX_USER=admin
INFLUX_PASSWORD=cambia-esta-clave-123
INFLUX_ORG=unab
# OJO: el dashboard y la alerta consultan el bucket "lab5". Si lo cambias aquí,
# cámbialo también en grafana/provisioning/dashboards/lab5.json y alerting/alertas.yaml
INFLUX_BUCKET=lab5
# Genera uno con:  openssl rand -hex 32
INFLUX_TOKEN=pon-aqui-un-token-largo-y-aleatorio

GRAFANA_USER=admin
GRAFANA_PASSWORD=cambia-esta-clave-456

DEVICE_ID=sensor-01
INTERVAL_S=10
