  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "### Qué mira el operador\nCondiciones ambientales del sensor **sensor-01** (MQTT → InfluxDB). Temperatura normal 20–28 °C; **sobre 32 °C se dispara la alerta** (línea roja). La humedad sube de noche y la luz es 0 de 18:00 a 06:00: eso es normal, no es falla. Un hueco en las curvas = el sensor dejó de publicar."
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Temperatura actual",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-lab5"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-lab5"
          },
          "query": "from(bucket: \"lab5\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"environment\" and r._field == \"temperature\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 15,
          "max": 40,
          "decimals": 1,
          "displayName": "Temperatura",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 28
              },
              {
                "color": "red",
                "value": 32
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "colorMode": "value",
        "graphMode": "none"
      }
    },
